    <div class="container">
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
    <h2 style="color: #333;">New Contact Form Submission</h2>

    <div style="background-color: #f9f9f9; padding: 20px; margin: 20px 0; border-radius: 5px;">
        <h3>Contact Details:</h3>
        <p><strong>Name:</strong> Test User</p>
        <p><strong>Email:</strong> test@example.com</p>
        <p><strong>Phone:</strong> 1234567890</p>
        <p><strong>Event Type:</strong> Wedding</p>
        <p><strong>Event Date:</strong> 28 Mar 2026</p>
        <p><strong>Number of Guests:</strong> 100</p>
        <p><strong>Services Required:</strong> Lawn, Decoration</p>
        <p><strong>Budget:</strong> 50000</p>
        <p><strong>Subject:</strong> Test Subject</p>
    </div>

    <div style="background-color: #fff; padding: 20px; margin: 20px 0; border: 1px solid #ddd; border-radius: 5px;">
        <h3>Message:</h3>
        <p style="white-space: pre-wrap;">This is a test message for the contact form.</p>
    </div>

    <p style="color: #666; font-size: 12px;">
        This email was sent from the Amaanta Farms contact form on 28 Mar 2026 at 06:31.
    </p>
</div>
